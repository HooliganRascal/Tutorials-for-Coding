#include<iostream>
#include<cstring>

const int in_row = 5;
const int in_col = 5;
const int ch_row = 5;
const int ch_col = 25;

int main(void){

	using namespace std;

	int arin[in_row][in_col]; // Normal 2-D int array
	char arch[ch_row][ch_col]; 
	char *arpt[ch_row]; // Array of ch_row pointers to arrays
	char (*ptar)[ch_col]; // Pointer to whole array with ch_col elements
	char **ptpt; // Pointer to pointer
	string arst[ch_row]; // Array of ch_row strings
	string *ptat; // Pointer to string
	
	return 0;
}
